{
  "rewrites": [
    {
      "source": "/((?!(assets/|robots\\.txt|sitemap\\.xml|favicon|.*\\..*)).*)",
      "destination": "/index.html"
    }
  ],
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_/backend"
    }
  }
}
